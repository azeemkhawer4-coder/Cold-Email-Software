# ==============================================================================
# OutboundOS Local Environment Configuration (Strict Zero-Cost Architecture)
# ==============================================================================
# All variables below are 100% OPTIONAL. OutboundOS starts and operates locally
# on your Windows laptop with zero external API keys, zero paid hosting, and
# zero cloud database subscriptions.
#
# To customize, copy this file to .env:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (macOS / Linux)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & LOCAL RUNTIME (Optional)
# ------------------------------------------------------------------------------
# PORT: Local web server port (default: 3000)
PORT=3000

# HOST: Bind address. Use "127.0.0.1" for local-only security, or "0.0.0.0" for LAN access.
HOST="127.0.0.1"

# OUTBOUNDOS_DATA_DIR: Custom path for SQLite database, backups, and encryption keys.
# Default on Windows: %LOCALAPPDATA%\OutboundOS\data
# Default on Linux/Mac: ./data
# OUTBOUNDOS_DATA_DIR="C:\Users\YourUser\AppData\Local\OutboundOS\data"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Optional - Free Tier Available)
# ------------------------------------------------------------------------------
# Used for sequence drafting, spam scoring, and reply sentiment classification.
# If omitted, OutboundOS continues working normally using local rule-based heuristics.
# Free API key: https://aistudio.google.com/app/apikey (1,500 requests/day free)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. GMAIL API OAUTH 2.0 (Optional - Free 500 to 2,000 emails/day)
# ------------------------------------------------------------------------------
# Connect individual Gmail or Google Workspace mailboxes via Google Cloud OAuth.
# Redirect URI to configure in Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 4. MICROSOFT GRAPH API OAUTH (Optional)
# ------------------------------------------------------------------------------
# Connect Outlook / Microsoft 365 mailboxes via Azure App Registration.
# Redirect URI: http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# ------------------------------------------------------------------------------
# 5. CUSTOM SMTP / IMAP DEFAULTS (Optional)
# ------------------------------------------------------------------------------
# You can connect unlimited mailboxes directly in the UI under "Email Accounts".
# These variables act only as default values if connecting via environment.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

IMAP_HOST=""
IMAP_PORT=993
IMAP_USER=""
IMAP_PASS=""
